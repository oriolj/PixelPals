; Engine configuration file.
; Hand-maintained: keep it small. Paint Party is vector art (not pixel art):
; 640x360 base, canvas_items stretch, linear filtering. No MSAA: the
; Compatibility renderer has no 2D MSAA, so edges use anti-aliased draw calls.

config_version=5

[application]

config/name="Paint Party"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Players="*res://autoload/players.gd"
Game="*res://autoload/game_state.gd"
Art="*res://autoload/art.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.2, 0.235, 0.34, 1)
