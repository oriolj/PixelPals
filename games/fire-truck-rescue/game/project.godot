; Engine configuration file.
; Hand-maintained: keep it small. The pixel settings are load-bearing.

config_version=5

[application]

config/name="Fire Truck Rescue"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Players="*res://autoload/players.gd"
Game="*res://autoload/game_state.gd"
Art="*res://autoload/art.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.11, 0.2, 1)
anti_aliasing/quality/msaa_3d=0
