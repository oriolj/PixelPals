; Engine configuration file.
; Hand-maintained: keep it small. The TV launcher: 1080p base, canvas_items stretch.

config_version=5

[application]

config/name="Couch Games"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"
run/low_processor_mode=false

[autoload]

Players="*res://autoload/players.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.1, 0.11, 0.17, 1)
